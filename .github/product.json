{
  "$schema": "https://raw.githubusercontent.com/waveshareteam/esp32-repo-template/v1/schema/product.schema.json",
  "product": "ESP32-C6-Touch-LCD-2.8",
  "product_url": "https://www.waveshare.com/ESP32-C6-Touch-LCD-2.8.htm",
  "tier": 0,
  "target": "esp32c6",
  "esp_idf": {
    "versions": [
      "v5.5.4"
    ]
  },
  "arduino": {
    "core": "3.3.12",
    "fqbn": "esp32:esp32:esp32c6:FlashSize=16M,FlashMode=qio,PartitionScheme=app3M_fat9M_16MB"
  },
  "factory_firmware": {
    "esp_idf": "v5.5.4"
  },
  "overrides": {
    "markdown_audit": {
      "classification_rules": [
        {
          "category": "first_party_customer",
          "patterns": [
            "examples/factory/components/XiaozhiApp/README*.md",
            "examples/factory/components/MicTest/README*.md",
            "examples/esp-idf/*/components/esp32_c6_touch_lcd_2_8/README*.md",
            "examples/factory/components/esp32_c6_touch_lcd_2_8/README*.md"
          ]
        },
        {
          "category": "embedded_upstream",
          "patterns": [
            "examples/factory/components/brookesia_core/**",
            "examples/factory/components/esp_xiaozhi/**",
            "examples/factory/components/mcp-c-sdk/**",
            "examples/factory/components/XiaozhiApp/third_party/xiaozhi_esp32/**",
            "examples/esp-idf/*/components/pedrominatel__shtc3/**",
            "examples/factory/components/pedrominatel__shtc3/**"
          ]
        }
      ]
    }
  }
}
